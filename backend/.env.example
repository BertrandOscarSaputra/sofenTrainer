# =============================================================================
# ENVIRONMENT VARIABLES FOR SOFEN TRAINER BACKEND
# =============================================================================
# Copy this file to .env.local and fill in the actual values
# The .env.local file is automatically loaded by Spring Boot

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/trainer?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# =============================================================================
# SPRING AI - GOOGLE GEMINI CONFIGURATION
# =============================================================================
# Required for AI recommendation and chat features
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# JWT SECURITY CONFIGURATION
# =============================================================================
# Generate a secure 256-bit BASE64 key: openssl rand -base64 32
JWT_SECRET=your_256_bit_base64_secret_key_here
JWT_EXPIRATION_MINUTES=1440

# =============================================================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# =============================================================================
# Server port (default: 3535)
# SERVER_PORT=3535

# Database connection pool settings (optional)
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
